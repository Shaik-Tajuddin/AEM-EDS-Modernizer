<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.adobe.aem.modernizer</groupId>
        <artifactId>aem-eds-modernizer</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>aem-eds-modernizer.all</artifactId>
    <packaging>content-package</packaging>

    <name>AEM → EDS Modernizer - All Package</name>
    <description>All content package container that embeds all other subpackages and core bundle for Cloud Manager</description>

    <properties>
        <skipBundleDeploy>true</skipBundleDeploy>
        <skipPackageDeploy>true</skipPackageDeploy>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.adobe.aem.modernizer</groupId>
            <artifactId>aem-eds-modernizer.core</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.adobe.aem.modernizer</groupId>
            <artifactId>aem-eds-modernizer.ui.apps</artifactId>
            <version>${project.version}</version>
            <type>zip</type>
        </dependency>
        <dependency>
            <groupId>com.adobe.aem.modernizer</groupId>
            <artifactId>aem-eds-modernizer.ui.config</artifactId>
            <version>${project.version}</version>
            <type>zip</type>
        </dependency>
        <dependency>
            <groupId>com.adobe.aem.modernizer</groupId>
            <artifactId>aem-eds-modernizer.ui.content</artifactId>
            <version>${project.version}</version>
            <type>zip</type>
        </dependency>

        <!-- WKND Clean Subpackages (Excludes sample package to ensure Cloud Manager OakPal compliance) -->
        <dependency>
            <groupId>com.adobe.aem.guides</groupId>
            <artifactId>aem-guides-wknd.core</artifactId>
            <version>${wknd.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.adobe.aem.guides</groupId>
            <artifactId>aem-guides-wknd.ui.apps</artifactId>
            <version>${wknd.version}</version>
            <type>zip</type>
        </dependency>
        <dependency>
            <groupId>com.adobe.aem.guides</groupId>
            <artifactId>aem-guides-wknd.ui.config</artifactId>
            <version>${wknd.version}</version>
            <type>zip</type>
        </dependency>
        <dependency>
            <groupId>com.adobe.aem.guides</groupId>
            <artifactId>aem-guides-wknd.ui.content</artifactId>
            <version>${wknd.version}</version>
            <type>zip</type>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.jackrabbit</groupId>
                <artifactId>filevault-package-maven-plugin</artifactId>
                <configuration>
                    <properties>
                        <cloudManagerTarget>all</cloudManagerTarget>
                    </properties>
                    <group>com.adobe.aem.modernizer</group>
                    <name>aem-eds-modernizer.all</name>
                    <packageType>container</packageType>
                    <embeddeds>
                        <!-- Modernizer Packages -->
                        <embedded>
                            <groupId>com.adobe.aem.modernizer</groupId>
                            <artifactId>aem-eds-modernizer.core</artifactId>
                            <target>/apps/aem-eds-modernizer-packages/application/install</target>
                        </embedded>
                        <embedded>
                            <groupId>com.adobe.aem.modernizer</groupId>
                            <artifactId>aem-eds-modernizer.ui.apps</artifactId>
                            <type>zip</type>
                            <target>/apps/aem-eds-modernizer-packages/application/install</target>
                        </embedded>
                        <embedded>
                            <groupId>com.adobe.aem.modernizer</groupId>
                            <artifactId>aem-eds-modernizer.ui.config</artifactId>
                            <type>zip</type>
                            <target>/apps/aem-eds-modernizer-packages/application/install</target>
                        </embedded>
                        <embedded>
                            <groupId>com.adobe.aem.modernizer</groupId>
                            <artifactId>aem-eds-modernizer.ui.content</artifactId>
                            <type>zip</type>
                            <target>/apps/aem-eds-modernizer-packages/content/install</target>
                        </embedded>

                        <!-- WKND Reference Sample Packages -->
                        <embedded>
                            <groupId>com.adobe.aem.guides</groupId>
                            <artifactId>aem-guides-wknd.core</artifactId>
                            <target>/apps/aem-eds-modernizer-packages/application/install</target>
                        </embedded>
                        <embedded>
                            <groupId>com.adobe.aem.guides</groupId>
                            <artifactId>aem-guides-wknd.ui.apps</artifactId>
                            <type>zip</type>
                            <target>/apps/aem-eds-modernizer-packages/application/install</target>
                        </embedded>
                        <embedded>
                            <groupId>com.adobe.aem.guides</groupId>
                            <artifactId>aem-guides-wknd.ui.config</artifactId>
                            <type>zip</type>
                            <target>/apps/aem-eds-modernizer-packages/application/install</target>
                        </embedded>
                        <embedded>
                            <groupId>com.adobe.aem.guides</groupId>
                            <artifactId>aem-guides-wknd.ui.content</artifactId>
                            <type>zip</type>
                            <target>/apps/aem-eds-modernizer-packages/content/install</target>
                        </embedded>
                    </embeddeds>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
