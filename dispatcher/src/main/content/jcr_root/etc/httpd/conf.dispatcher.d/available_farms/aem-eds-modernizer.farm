/farm-modernizer {
    /clientheaders {
        "*"
    }
    /virtualhosts {
        "modernizer.local"
        "localhost"
        "127.0.0.1"
    }
    /renders {
        /rend01 {
            /hostname "127.0.0.1"
            /port "4502"
            /timeout "600"
        }
    }
    /filter {
        /0001 { /type "allow" /glob "*" }
    }
    /cache {
        /docroot "/var/www/html"
        /rules {
            /0000 {
                /glob "*"
                /type "deny"
            }
        }
    }
}
